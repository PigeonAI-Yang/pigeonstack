{
  "description": "Read the uniquely session-bound current region of an existing task record as untrusted data.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/windows_session_start.ps1\"",
            "timeout": 5,
            "additionalContextLimit": 0,
            "statusMessage": "Reading bound current task context"
          }
        ]
      }
    ]
  }
}
